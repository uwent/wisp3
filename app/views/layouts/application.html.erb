<!DOCTYPE html>
<html lang="en">
  <head>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="WISP">
    <meta name="description" content="Wisconsin Irrigation Scheduling Program: daily soil water balance and forecast-driven irrigation scheduling.">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%# Google Analytics on the public pages (app/frontend/lib/analytics.ts), when configured %>
    <% if (ga_id = ENV["GA_MEASUREMENT_ID"].presence) %>
      <meta name="ga-measurement-id" content="<%= ga_id %>">
    <% end %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%# Add to Home Screen: the manifest (public/manifest.webmanifest; no service worker, no offline) and
        iOS's icon. The browser's bars take the branding bar's red, light and dark, so the top runs on %>
    <link rel="manifest" href="/manifest.webmanifest">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <meta name="apple-mobile-web-app-title" content="WISP">
    <meta name="theme-color" content="#cf0a1b" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#a3030e" media="(prefers-color-scheme: dark)">

    <%# The light/dark choice from the theme toggle (app/frontend/lib/theme.ts), applied before the page paints %>
    <script nonce="<%= content_security_policy_nonce %>">
      try {
        var theme = localStorage.getItem("wisp-theme");
        if (theme === "light" || theme === "dark") document.documentElement.dataset.theme = theme;
      } catch (e) {}
    </script>

    <%= vite_stylesheet_tag "application" %>
    <%= vite_client_tag %>
    <%= vite_typescript_tag "inertia" %>
    <%= inertia_ssr_head %>
  </head>

  <body class="min-h-dvh bg-surface text-ink antialiased">
    <%= yield %>
  </body>
</html>
