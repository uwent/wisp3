<!DOCTYPE html>
<%# Like the app's pages: the UW bar, WISP's header, the email, then a footer. Built from tables with inline
    styles for Outlook, on a white page (a tinted one shows badly there) %>
<% c = EmailHelper::COLORS %>
<html lang="en">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light">
    <meta name="supported-color-schemes" content="light">
    <title><%= message.subject %></title>
    <!--[if mso]><style>body, table, td, p, a, span, li, h1, h2, h3, h4, h5, h6 { font-family: 'Segoe UI', Arial, sans-serif !important; }</style><![endif]-->
  </head>

  <body style="margin:0;padding:0;background:<%= c[:white] %>;-webkit-text-size-adjust:100%">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="<%= c[:white] %>" style="background:<%= c[:white] %>;font-family:<%= EmailHelper::FONT %>;color:<%= c[:ink] %>;font-size:15px;line-height:1.5">
      <tr>
        <td bgcolor="<%= c[:uw_red] %>" style="background:<%= c[:uw_red] %>;padding:0 16px">
          <%= email_column(padding: "8px 0") do %>
            <a ses:no-track href="https://www.wisc.edu" style="color:<%= c[:white] %>;text-decoration:none;font-size:13px;font-weight:600;letter-spacing:0.02em">University of Wisconsin–Madison</a>
          <% end %>
        </td>
      </tr>
      <tr>
        <td style="padding:0 16px;border-bottom:1px solid <%= c[:line] %>">
          <%= email_column(padding: "14px 0") do %>
            <table role="presentation" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td width="40" style="vertical-align:middle"><a ses:no-track href="<%= root_url %>" tabindex="-1"><img src="<%= root_url %>icon-email.png" width="40" height="40" alt="" style="display:block;border:0"></a></td>
                <td style="vertical-align:middle;padding-left:12px">
                  <a ses:no-track href="<%= root_url %>" style="display:block;font-family:<%= EmailHelper::DISPLAY_FONT %>;font-size:22px;line-height:1.1;font-weight:700;letter-spacing:-0.01em;color:<%= c[:ink] %>;text-decoration:none">WISP</a>
                  <span style="display:block;font-size:13px;line-height:1.3;color:<%= c[:muted] %>">Wisconsin Irrigation Scheduling Program</span>
                </td>
              </tr>
            </table>
          <% end %>
        </td>
      </tr>
      <tr>
        <td style="padding:0 16px">
          <%= email_column(padding: "28px 0 16px") do %>
            <%= yield %>
          <% end %>
        </td>
      </tr>
      <tr>
        <td bgcolor="<%= c[:uw_gray_lightest] %>" style="background:<%= c[:uw_gray_lightest] %>;border-top:1px solid <%= c[:line] %>;padding:0 16px;font-size:12px;line-height:1.5;color:<%= c[:muted] %>">
          <%= email_column(padding: "20px 0 24px") do %>
            <% if content_for?(:footer) %>
              <p style="margin:0 0 12px"><%= yield :footer %></p>
            <% end %>
            <p style="margin:0">
              <strong style="color:<%= c[:ink] %>">WISP</strong> · Wisconsin Irrigation Scheduling Program<br>
              Developed by the <%= email_link_to "College of Agricultural and Life Sciences", "https://cals.wisc.edu/" %> at the University of Wisconsin–Madison.
            </p>
          <% end %>
        </td>
      </tr>
    </table>
  </body>
</html>
