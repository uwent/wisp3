<% muted = email_style(:muted) %>
<h1 style="<%= email_style(:h1) %>">WISP health check</h1>
<p style="margin:0 0 24px;font-size:14px;<%= muted %>"><%= @now.strftime("%A, %B %-d, %-l:%M %p %Z") %> · <%= pluralize(@problems.size, "problem") %> found</p>

<% @problems.each do |problem| %>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="<%= email_style(:card) %>">
    <tr>
      <td style="<%= email_style(:card_header) %>">
        <h2 style="font-size:16px;line-height:1.3;margin:0"><%= problem.summary %></h2>
      </td>
    </tr>
    <tr>
      <td style="padding:12px 16px">
        <ul style="margin:0;padding-left:20px;font-size:14px">
          <% problem.details.each do |detail| %>
            <li style="margin:0 0 4px"><%= detail %></li>
          <% end %>
        </ul>
        <% if problem.kind == :missing_weather %>
          <p style="margin:8px 0 0;font-size:14px"><%= email_link_to "Weather status", @weather_url %></p>
        <% end %>
      </td>
    </tr>
  </table>
<% end %>

<% content_for :footer do %>
  Sent to WISP's admins each morning when something needs attention. The same list is at the top of <%= email_link_to "the weather status page", @weather_url %>.
<% end %>
