Your fields this morning, <%= @digest.today.strftime("%A, %B %-d") %>
<% if @digest.attention.any? %>

NEEDS ATTENTION
<% @digest.attention.each do |entry| %>

<%= entry.field.name %> [<%= status_label(entry.status.status) %>]
<%= digest_place(entry, @digest) %>
<% if entry.outlook %><%= entry.outlook.headline %>. <%= entry.outlook.detail %><%= " #{entry.outlook.chance}" if entry.outlook.chance %>
<% end %><%= digest_ad(entry, @digest) %>
Last rain: <%= digest_last(entry, @digest, :rain) %> · Last irrigation: <%= digest_last(entry, @digest, :irrigation) %>
<%= field_link(entry) %>
<% end %>
<% end %>
<% if @digest.others.any? %>

<%= @digest.attention.any? ? "EVERYTHING ELSE" : "ALL FIELDS" %>

<% @digest.others.each do |entry| %>
- <%= entry.field.name %> [<%= status_label(entry.status.status) %>]: <%= digest_ad(entry, @digest, short: true) %>. <%= digest_summary(entry) %>
<% end %>
<% end %>

