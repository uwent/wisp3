<% muted = "color:#5b6470" %>
<div style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#141b24;max-width:600px;font-size:14px;line-height:1.45">
  <h1 style="font-size:20px;margin:0 0 4px">Your fields this morning</h1>
  <p style="margin:0 0 20px;<%= muted %>"><%= @digest.today.strftime("%A, %B %-d") %> · water balance through today, projected with the latest forecast</p>

  <% if @digest.attention.any? %>
    <h2 style="font-size:16px;margin:0 0 8px">Needs attention</h2>
    <% @digest.attention.each do |entry| %>
      <% outlook = entry.outlook %>
      <div style="border:1px solid #e3e6ea;border-left:4px solid <%= DigestMailer::STATUSES.dig(entry.status.status, :color) %>;border-radius:6px;padding:12px 14px;margin:0 0 12px">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr>
          <td style="font-size:16px;font-weight:600"><%= email_link_to entry.field.name, field_link(entry) %></td>
          <td align="right"><span style="<%= status_style(entry.status.status) %>"><%= status_label(entry.status.status) %></span></td>
        </tr></table>
        <div style="font-size:12px;<%= muted %>;margin:2px 0 8px"><%= digest_place(entry, @digest) %></div>
        <% if outlook %>
          <div style="font-weight:600;<%= "color:#cc2827" if outlook.urgent %>"><%= outlook.headline %></div>
          <div><%= outlook.detail %><% if outlook.chance %> <%= outlook.chance %><% end %></div>
        <% end %>
        <div style="font-size:13px;margin-top:8px"><%= digest_ad(entry, @digest) %></div>
        <div style="font-size:13px;<%= muted %>">Last rain: <%= digest_last(entry, @digest, :rain) %> · Last irrigation: <%= digest_last(entry, @digest, :irrigation) %></div>
      </div>
    <% end %>
  <% end %>

  <% if @digest.others.any? %>
    <h2 style="font-size:16px;margin:20px 0 8px"><%= @digest.attention.any? ? "Everything else" : "All fields" %></h2>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="font-size:13px">
      <% @digest.others.each do |entry| %>
        <tr>
          <td width="1" style="padding:6px 10px 6px 0;border-top:1px solid #e3e6ea;white-space:nowrap;vertical-align:top"><span style="<%= status_style(entry.status.status) %>"><%= status_label(entry.status.status) %></span></td>
          <td style="padding:6px 0;border-top:1px solid #e3e6ea">
            <%= email_link_to entry.field.name, field_link(entry) %>
            <span style="<%= muted %>">· <%= digest_ad(entry, @digest, short: true) %></span><br>
            <span style="<%= muted %>"><%= digest_summary(entry) %></span>
          </td>
        </tr>
      <% end %>
    </table>
  <% end %>

  <p style="margin:24px 0 0;font-size:12px;<%= muted %>">
    You get this email from WISP each morning while your fields are in season.
    <%= email_link_to "Choose which fields it covers", @settings_url %> or <%= email_link_to "unsubscribe", @unsubscribe_url %>.
  </p>
</div>
