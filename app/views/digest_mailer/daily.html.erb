<% muted = "color:#5b6470" %>
<% rule = "border-top:1px solid #e3e6ea" %>
<div style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#141b24;max-width:600px;font-size:14px;line-height:1.45">
  <h1 style="font-size:20px;margin:0 0 4px">Your fields this morning</h1>
  <p style="margin:0 0 20px;<%= muted %>"><%= @digest.today.strftime("%A, %B %-d") %> · water balance through today, projected with the latest forecast</p>

  <% if @digest.attention.any? %>
    <div style="border:1px solid #e3e6ea;border-radius:6px;padding:12px 14px;margin:0 0 24px">
      <h2 style="font-size:16px;margin:0 0 8px">Needs attention</h2>
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="font-size:13px">
        <% @digest.attention.each do |entry| %>
          <tr>
            <td width="1" style="padding:6px 10px 6px 0;<%= rule %>;white-space:nowrap;vertical-align:top"><span style="<%= status_style(entry.status.status) %>"><%= status_label(entry.status.status) %></span></td>
            <td style="padding:6px 0;<%= rule %>">
              <%= email_link_to entry.field.name, field_link(entry) %>
              <span style="<%= muted %>">· <%= digest_place(entry, @digest) %></span><br>
              <% if entry.outlook %><span style="font-weight:600;<%= "color:#cc2827" if entry.outlook.urgent %>"><%= entry.outlook.headline %></span><% end %>
            </td>
          </tr>
        <% end %>
      </table>
    </div>
  <% end %>

  <% @digest.farms.each do |section| %>
    <h2 style="font-size:18px;margin:24px 0 8px;padding-bottom:4px;border-bottom:2px solid #141b24"><%= digest_farm(section, @digest) %></h2>
    <% section.pivots.each do |pivot_section| %>
      <h3 style="font-size:15px;margin:16px 0 4px"><%= email_link_to pivot_section.pivot.name, pivot_link(pivot_section.pivot) %></h3>
      <div style="font-size:12px;<%= muted %>;background:#f4f6f8;border-radius:4px;padding:6px 10px;margin:0 0 6px">
        <%= safe_join(digest_weather(pivot_section, @digest), tag.br) %>
      </div>
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="font-size:13px">
        <% pivot_section.entries.each do |entry| %>
          <tr>
            <td width="1" style="padding:8px 10px 8px 0;<%= rule %>;white-space:nowrap;vertical-align:top"><span style="<%= status_style(entry.status.status) %>"><%= status_label(entry.status.status) %></span></td>
            <td style="padding:8px 0;<%= rule %>">
              <span style="font-weight:600"><%= email_link_to entry.field.name, field_link(entry) %></span>
              <span style="<%= muted %>">· <%= digest_crop(entry) %> · <%= digest_ad(entry, @digest, short: !entry.attention?) %></span><br>
              <% if entry.attention? && entry.outlook %>
                <span style="font-weight:600;<%= "color:#cc2827" if entry.outlook.urgent %>"><%= entry.outlook.headline %></span><br>
                <%= entry.outlook.detail %><% if entry.outlook.chance %> <%= entry.outlook.chance %><% end %><br>
                <span style="<%= muted %>">Last rain: <%= digest_last(entry, @digest, :rain) %> · Last irrigation: <%= digest_last(entry, @digest, :irrigation) %></span>
              <% else %>
                <span style="<%= muted %>"><%= digest_summary(entry) %></span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </table>
    <% end %>
  <% end %>

  <p style="margin:24px 0 0;font-size:12px;<%= muted %>">
    <%= digest_reason(@user, test: @test) %>
    <%= email_link_to "Change how often and which fields", @alerts_url %> or <%= email_link_to "unsubscribe", @unsubscribe_url %>.
  </p>
</div>
