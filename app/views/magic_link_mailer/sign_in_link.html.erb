<% c = EmailHelper::COLORS %>
<p style="<%= email_style(:p) %>">Hello <%= @user.display_name %>,</p>

<p style="<%= email_style(:p) %>">Enter this code on the WISP sign-in page:</p>

<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 20px">
  <tr>
    <td bgcolor="<%= c[:uw_gray_lightest] %>" style="background:<%= c[:uw_gray_lightest] %>;border:1px solid <%= c[:line] %>;border-radius:8px;padding:12px 24px;font-family:Menlo,Consolas,'Courier New',monospace;font-size:28px;font-weight:700;letter-spacing:6px;color:<%= c[:ink] %>"><%= @code %></td>
  </tr>
</table>

<p style="<%= email_style(:p) %>">Or, on the device where you read this email, use this link:</p>

<%= email_button "Sign in to WISP", @url %>

<p style="<%= email_style(:p) %>">Each can be used once, and both expire in <%= @ttl_minutes %> minutes.</p>

<p style="<%= email_style(:p, :muted) %>;font-size:14px">If you didn't ask to sign in, you can safely ignore this email. No one can sign in without the code or the link.</p>
