<p style="<%= email_style(:p) %>">Welcome to WISP, <%= @email %>.</p>

<p style="<%= email_style(:p) %>">Please confirm your email address with the button below. After that you can sign in.</p>

<%= email_button "Confirm my email", confirmation_url(@resource, confirmation_token: @token) %>

<p style="<%= email_style(:p, :muted) %>;font-size:14px">If you didn't create a WISP account, you can ignore this email.</p>
